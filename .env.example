# Sportel configuration.
#   cp .env.example .env        # read by `docker compose`
#   cp .env.example api/.env    # read by the API when it runs from api/ (`make api`, `make dev`)
# .env files are gitignored. Never commit a real key, and never put it in web/.

# ---------------------------------------------------------------- api
# Optional. No key = RULES mode (header badge "RREGULLA"): column mapping by synonyms and fuzzy
# matching, example questions only, nothing is sent to any AI service.
# Set a key for AI LIVE: a fast model proposes column mappings, a smarter model reads free-text
# questions. Code still computes every number. Check a key with:
#   cd api && uv run python scripts/check_llm.py
# LLM_PROVIDER=auto uses OpenAI when OPENAI_API_KEY is set, otherwise Anthropic.
LLM_PROVIDER=auto
# The organisers' team key (AI4Society starter pack, $10 per team). AI_API_KEY also works.
OPENAI_API_KEY=
# The organisers' gateway (AI_BASE_URL also works). Empty = api.openai.com.
OPENAI_BASE_URL=https://llm.mjovanovic.dev/v1
# Both jobs on gpt-5-mini, as the starter pack recommends (gpt-5 "sparingly").
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MODEL_SMART=gpt-5-mini
# Alternative provider: Claude Haiku 4.5 (mapping) and Claude Sonnet 5 (questions).
ANTHROPIC_API_KEY=

# Spend cap in USD for this server. At the cap the API switches to RULES mode by itself.
# With the $10 team key keep it at about 6, so budget stays for Sunday's demo.
# Spend is restored from the llm_call log at start-up. Keep it at 60-70% of the key's real cap.
LLM_BUDGET_USD=6

# false (default): AI column mapping sees headers and types only, no cell values leave the server.
# true: also send up to 5 masked sample values per non-personal column (higher confidence).
LLM_SEND_SAMPLES=false

# DuckDB file, relative to api/ (docker compose overrides it with /data/pulse.duckdb).
DUCKDB_PATH=data/pulse.duckdb

# Browser origins allowed to call the API: a JSON list or a comma-separated string.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3100"]

# Enables POST /api/v1/demo/reset and DELETE /api/v1/ingest/recipes.
# Set to false on any server that other people can reach.
DEMO_RESET_ENABLED=true

# Server-side sample exports listed on /ingest and used by the seed (relative to api/).
SAMPLES_DIR=samples

# ---------------------------------------------------------------- web
# Next.js reads these from web/.env.local (for `pnpm dev`) or at build time.
# docker compose passes NEXT_PUBLIC_API_URL as a build argument.
NEXT_PUBLIC_API_URL=http://localhost:8000

# 1 forces REPLAY: recorded API responses over the synthetic samples, badged "REPLAY" in the
# header. Without it, REPLAY starts on its own only when the API cannot be reached.
NEXT_PUBLIC_USE_FIXTURES=0
